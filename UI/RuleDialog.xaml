<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Aplicación" FontWeight="SemiBold"/>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Examinar…" Margin="8,0,0,0" Padding="12,4" x:Name="BrowseButton"/>
                <TextBox x:Name="AppBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="…o elige una ventana abierta" Margin="0,10,0,0" Opacity="0.75"/>
            <ComboBox x:Name="WindowsBox" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
            <TextBlock Text="…o elige una aplicación del arranque de Windows" Margin="0,10,0,0" Opacity="0.75"/>
            <ComboBox x:Name="StartupBox" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
            <TextBlock Text="Si la ventana de una aplicación no se coloca, ábrela y elígela en la lista de ventanas abiertas."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock Text="Monitor" FontWeight="SemiBold" Margin="0,18,0,0"/>
            <ComboBox x:Name="MonitorBox" Margin="0,6,0,0" HorizontalAlignment="Stretch"
/>

            <TextBlock Text="Modo" FontWeight="SemiBold" Margin="0,18,0,0"/>
            <RadioButton x:Name="MaxRadio" Content="Maximizada" IsChecked="True" GroupName="m" Margin="0,6,0,0"/>
            <RadioButton x:Name="NormalRadio" Content="Normal (se mueve al monitor conservando su tamaño)" GroupName="m"/>
            <RadioButton x:Name="CustomRadio" Content="Personalizada" GroupName="m"/>

            <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="X"/><TextBox x:Name="XBox" Text="0"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="Y"/><TextBox x:Name="YBox" Text="0"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="Ancho"/><TextBox x:Name="WBox" Text="1280"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Alto"/><TextBox x:Name="HBox" Text="720"/></StackPanel>
                </Grid>
                <TextBlock Text="En píxeles, desde la esquina superior izquierda del área útil del monitor."
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Button Content="Usar la posición actual de la ventana" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Padding="12,4" x:Name="UseCurrentButton"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Aceptar" IsDefault="True" Padding="20,6" Margin="0,0,8,0" x:Name="OkButton"
                        Style="{DynamicResource AccentButtonStyle}"/>
                <Button Content="Cancelar" IsCancel="True" Padding="20,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

