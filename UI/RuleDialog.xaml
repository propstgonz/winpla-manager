<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Application" FontWeight="SemiBold"/>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Padding="12,4" x:Name="BrowseButton"/>
                <TextBox x:Name="AppBox" IsReadOnly="True" VerticalContentAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="…or pick an open window" Margin="0,10,0,0" Opacity="0.75"/>
            <ComboBox x:Name="WindowsBox" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
            <TextBlock Text="…or pick an app that starts with Windows" Margin="0,10,0,0" Opacity="0.75"/>
            <ComboBox x:Name="StartupBox" Margin="0,4,0,0" HorizontalAlignment="Stretch"/>
            <TextBlock Text="If an app's window isn't being placed, open the app and pick it from the list of open windows."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <TextBlock Text="Monitor" FontWeight="SemiBold" Margin="0,18,0,0"/>
            <ComboBox x:Name="MonitorBox" Margin="0,6,0,0" HorizontalAlignment="Stretch"
/>

            <TextBlock Text="Mode" FontWeight="SemiBold" Margin="0,18,0,0"/>
            <RadioButton x:Name="MaxRadio" Content="Maximized" IsChecked="True" GroupName="m" Margin="0,6,0,0"/>
            <RadioButton x:Name="NormalRadio" Content="Normal (moves to the monitor and keeps its size)" GroupName="m"/>
            <RadioButton x:Name="CustomRadio" Content="Custom" GroupName="m"/>

            <StackPanel x:Name="CustomPanel" Visibility="Collapsed" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,6,0"><TextBlock Text="X"/><TextBox x:Name="XBox" Text="0"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,6,0"><TextBlock Text="Y"/><TextBox x:Name="YBox" Text="0"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,6,0"><TextBlock Text="Width"/><TextBox x:Name="WBox" Text="1280"/></StackPanel>
                    <StackPanel Grid.Column="3"><TextBlock Text="Height"/><TextBox x:Name="HBox" Text="720"/></StackPanel>
                </Grid>
                <TextBlock Text="In pixels, from the top-left corner of the monitor's usable area."
                           Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <Button Content="Use the window's current position" HorizontalAlignment="Left"
                        Margin="0,8,0,0" Padding="12,4" x:Name="UseCurrentButton"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="OK" IsDefault="True" Padding="20,6" Margin="0,0,8,0" x:Name="OkButton"
                        Style="{DynamicResource AccentButtonStyle}"/>
                <Button Content="Cancel" IsCancel="True" Padding="20,6"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

