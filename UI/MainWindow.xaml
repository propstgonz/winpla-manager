<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Rules -->
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Add application" Padding="16,6" x:Name="AddButton"
                        Style="{DynamicResource AccentButtonStyle}"/>
                <TextBlock Text="Applications" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock x:Name="EmptyText" Text="No applications yet. Add one to get started."
                       Opacity="0.7" Margin="0,8,0,8"/>
            <ItemsControl x:Name="RulesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="0,0,0,0.5" Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Opacity="0.75" TextWrapping="Wrap">
                                        <Run Text="{Binding MonitorText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ModeText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="Monitor disconnected" Foreground="OrangeRed"
                                               Visibility="{Binding DisconnectedVisibility}"/>
                                </StackPanel>
                                <CheckBox Grid.Column="2" Content="Enabled" IsChecked="{Binding Enabled, Mode=OneWay}"
                                          Margin="8,0" VerticalAlignment="Center" Tag="enabled"/>
                                <Button Grid.Column="3" Content="Edit" Margin="4,0" Padding="12,4" Tag="edit"/>
                                <Button Grid.Column="4" Content="Remove" Padding="12,4" Tag="delete"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Monitors -->
            <TextBlock Text="Monitors" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,8"/>
            <ItemsControl x:Name="MonitorsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,2">
                            <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Name, Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Settings -->
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,28,0,8"/>
            <CheckBox x:Name="AutostartBox" Content="Start with Windows" Margin="0,4" />
            <CheckBox x:Name="AutoPlaceBox" Content="Place windows automatically at sign-in"
                      Margin="0,4" />
            <Button x:Name="ApplyButton" Content="Apply rules now" HorizontalAlignment="Left"
                    Padding="16,6" Margin="0,12,0,0" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>

